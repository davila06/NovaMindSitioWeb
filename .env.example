# Contact form delivery options
MAIL_PROVIDER=auto
# Option 1: Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=info@novamindglobalcr.com
CONTACT_TO_EMAIL=novamindglobalcr@gmail.com
# Optional segment-specific lead routing; defaults to CONTACT_TO_EMAIL.
CONTACT_B2C_TO_EMAIL=
CONTACT_B2B_TO_EMAIL=

# Option 2: SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Contact form security
# These are local-development limits. Workers uses the bindings in cloudflare.config.ts.
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
# Public widget key, embedded at build time. Use the matching real widget key
# for each staging/production hostname; official dummy keys are local/CI only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Keep disabled for ordinary local development. Production must enable verification.
TURNSTILE_ENABLED=false
# Secret, server-side only. Configure the matching real secret separately for
# staging and production in the secret store; never commit it or use test keys there.
TURNSTILE_SECRET_KEY=
# Test-only bypass: honored only when NODE_ENV=test. Never set in deployment environments.
TURNSTILE_TEST_BYPASS=false

# Public canonical site URL (optional for local development)
NEXT_PUBLIC_SITE_URL=

# Analytics
NEXT_PUBLIC_GA_ID=G-NYG6JCK4S2
NEXT_PUBLIC_GA_ENABLED=false
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_CLARITY_ENABLED=false

# Monitoring
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_FORMAT=generic
MONITORING_ALERT_MIN_SEVERITY=error
MONITORING_ALERT_SERVICE=novamind-web
