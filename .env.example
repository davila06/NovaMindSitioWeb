# Contact form delivery options
MAIL_PROVIDER=auto
# Option 1: Resend
RESEND_API_KEY=
CONTACT_FROM_EMAIL=info@novamindglobalcr.com
CONTACT_TO_EMAIL=novamindglobalcr@gmail.com

# Option 2: SMTP fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Contact form security
# These are local-development limits. Workers uses the bindings in cloudflare.config.ts.
CONTACT_RATE_LIMIT_MAX_REQUESTS=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000
# Local development only; Workers enables Turnstile through its bindings.
# Use an official test site key and matching test secret for automated E2E.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Analytics
NEXT_PUBLIC_GA_ID=G-NYG6JCK4S2
NEXT_PUBLIC_CLARITY_ID=

# Monitoring
MONITORING_WEBHOOK_URL=
MONITORING_WEBHOOK_FORMAT=generic
MONITORING_ALERT_MIN_SEVERITY=error
MONITORING_ALERT_SERVICE=novamind-web
