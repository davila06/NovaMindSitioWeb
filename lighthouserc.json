{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "startServerCommand": "node scripts/lhci-retry.mjs serve",
      "startServerReadyPattern": "Lighthouse preview HTTP ready",
      "startServerReadyTimeout": 120000,
      "settings": {
        "preset": "desktop",
        "throttlingMethod": "simulate",
        "budgets": [
          {
            "path": "/*",
            "resourceSizes": [
              {
                "resourceType": "script",
                "budget": 320
              },
              {
                "resourceType": "image",
                "budget": 1100
              },
              {
                "resourceType": "font",
                "budget": 180
              },
              {
                "resourceType": "total",
                "budget": 2000
              }
            ],
            "timings": [
              {
                "metric": "first-contentful-paint",
                "budget": 1800
              },
              {
                "metric": "interactive",
                "budget": 3800
              }
            ]
          }
        ]
      },
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/nova-assist",
        "http://127.0.0.1:3000/nova-assist/visita-express",
        "http://127.0.0.1:3000/nova-assist/plan-familia",
        "http://127.0.0.1:3000/nova-assist/total-home",
        "http://127.0.0.1:3000/nova-assist/comparar",
        "http://127.0.0.1:3000/nova-assist/solicitar"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": ["warn", { "minScore": 0.9 }],
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
            "interactive": ["warn", { "maxNumericValue": 3800 }],
            "total-blocking-time": ["warn", { "maxNumericValue": 200 }],
            "uses-responsive-images": ["warn"],
            "unused-javascript": ["warn"],
            "uses-rel-preconnect": ["warn"]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*\\/nova-assist\\/solicitar(?:\\?.*)?$).*",
          "assertions": {
            "categories:seo": ["error", { "minScore": 1.0 }]
          }
        }
      ]
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
