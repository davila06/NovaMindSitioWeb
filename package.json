{
  "name": "sitio-web",
  "private": true,
  "type": "module",
  "imports": {
    "#platform": {
      "workerd": "./lib/platform.cloudflare.ts",
      "default": "./lib/platform.ts"
    }
  },
  "version": "0.0.0",
  "engines": {
    "node": "^24.22.0"
  },
  "scripts": {
    "content:index": "node scripts/generate-content-index.mjs",
    "predev": "npm run content:index",
    "prebuild": "npm run content:index",
    "build:cloudflare": "npm run content:index && cf build",
    "dev:cloudflare": "npm run content:index && cf dev",
    "preview:cloudflare": "vite preview",
    "deploy:cloudflare": "npm run build:cloudflare && cf deploy --prebuilt --mode production",
    "types:cloudflare": "cf workers types",
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components data lib hooks tests scripts *.ts *.mjs",
    "test:unit": "vitest run --coverage",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "perf:assets": "node scripts/generate-image-variants.mjs",
    "perf:lhci:collect": "lhci collect --config=lighthouserc.json",
    "perf:lhci:assert": "lhci assert --config=lighthouserc.json",
    "perf:lhci": "lhci autorun --config=lighthouserc.json",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.474.0",
    "next": "^15.2.0",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "web-vitals": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^15.5.12",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.37",
    "@vitest/coverage-v8": "5.0.5",
    "cf": "1.0.0-beta.26",
    "eslint": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vinext": "1.4.0",
    "vite": "^8.0.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": {
      ".": "11.0.3",
      "brace-expansion": "5.0.12"
    },
    "@lhci/cli": {
      "chrome-launcher": "1.2.2"
    },
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    },
    "@puppeteer/browsers": "3.2.6",
    "basic-ftp": "6.2.1",
    "brace-expansion": "1.1.21",
    "fflate": "0.7.5",
    "lighthouse": "13.6.0",
    "postcss": "8.5.32",
    "puppeteer-core": "25.16.0",
    "qs": "6.16.2",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "zod": "$zod"
  }
}
